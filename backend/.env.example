# Copy to .env and fill in. .env is git-ignored; this file is not.

PROJECT_NAME="Riddhi Siddhi Arts & Crafts API"

# development | production
# In production the app refuses to start without a strong SECRET_KEY, disables
# /docs, and will not auto-apply migrations.
ENVIRONMENT=development

# Leave blank in development: a machine-local key is generated into
# backend/.secret_key on first run.
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Set USE_SQLITE_FALLBACK=false to use DATABASE_URL instead.
USE_SQLITE_FALLBACK=true
SQLITE_URL="sqlite+aiosqlite:///./riddhi_siddhi.db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/riddhi_siddhi_db"

UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=25

# Exact origins allowed to call the API with credentials. Never "*".
# Add the production domain here before deploying.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001"

# Anonymous enquiry/review submissions allowed per IP per window.
PUBLIC_SUBMIT_LIMIT=5
PUBLIC_SUBMIT_WINDOW_SECONDS=60

# Used only by seed.py when creating the first admin. If blank, a random
# password is generated and printed once.
SEED_ADMIN_EMAIL="admin@riddhisiddhi.com"
SEED_ADMIN_PASSWORD=
